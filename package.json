{
  "name": "dsh-model-gear",
  "version": "0.4.1",
  "description": "DeepSeek Harness 输入框的模型挡位面板：模型选择、推理强度滑条、显示名，外加闪电编排三档（唯一的提示词注入）· Model gear for the DSH composer; the only prompt text it adds is the Lightning contract",
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/smoke.mjs && node tests/render.mjs && node tests/host.mjs && node tests/style-owner.mjs",
    "check": "node scripts/build.mjs && git diff --exit-code -- lib",
    "prepack": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "author": "chenyuxuan-official",
  "homepage": "https://github.com/chenyuxuan-official/dsh-model-gear#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenyuxuan-official/dsh-model-gear.git"
  },
  "bugs": {
    "url": "https://github.com/chenyuxuan-official/dsh-model-gear/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model",
    "model-picker",
    "reasoning-effort",
    "orchestration"
  ]
}
